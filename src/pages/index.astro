---
const title = 'Marketing digital para marcas en crecimiento | CVG';
const description =
  'Estrategia, contenido, páginas web y campañas digitales para marcas que necesitan claridad y crecimiento sostenible.';

const services = [
  {
    number: '01',
    title: 'Estrategia digital',
    text: 'Un plan conectado con tus objetivos, tu audiencia y la realidad de tu negocio.',
  },
  {
    number: '02',
    title: 'Contenido de marca',
    text: 'Mensajes y piezas que expresan con claridad por qué tu marca importa.',
  },
  {
    number: '03',
    title: 'Campañas digitales',
    text: 'Medios y optimización para acercar tu propuesta a las personas adecuadas.',
  },
  {
    number: '04',
    title: 'Páginas web',
    text: 'Sitios claros y funcionales que presentan tu marca y ayudan a convertir visitas en oportunidades.',
  },
];

const steps = [
  { number: '01', title: 'Entendemos', text: 'Revisamos tus objetivos, tu oferta y los retos que quieres resolver.' },
  { number: '02', title: 'Definimos', text: 'Priorizamos una estrategia y acordamos cómo medir el avance.' },
  { number: '03', title: 'Activamos', text: 'Ponemos el plan en marcha y ajustamos cada acción con criterio.' },
];

const faqs = [
  {
    question: '¿Qué incluye el diagnóstico inicial?',
    answer: 'Una conversación para entender tu negocio, revisar tus prioridades y proponer un siguiente paso claro.',
  },
  {
    question: '¿Con qué tipo de empresas trabajan?',
    answer: 'Con pequeñas y medianas empresas y marcas en crecimiento que buscan ordenar su marketing digital.',
  },
  {
    question: '¿Qué servicios ofrece CVG?',
    answer: 'Estrategia digital, contenido de marca, creación de páginas web y campañas. El alcance se define según tus objetivos.',
  },
  {
    question: '¿Cuándo se pueden ver avances?',
    answer: 'Depende del punto de partida, los canales y la inversión. Acordamos señales de avance antes de activar el plan.',
  },
  {
    question: '¿Cómo se mide el desempeño?',
    answer: 'Elegimos indicadores relacionados con tus objetivos y revisamos los resultados para decidir qué optimizar.',
  },
  {
    question: '¿Hay un compromiso de permanencia?',
    answer: 'El alcance, los tiempos y las condiciones se conversan antes de iniciar cualquier trabajo.',
  },
];

const whatsappMessage = encodeURIComponent('Hola, quiero conversar sobre el marketing digital de mi negocio.');
const whatsappNumber = '573136269953';
const contactHref = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f5f3" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Ir al contenido</a>

    <header class="site-header">
      <a class="wordmark" href="#inicio" aria-label="CVG and Co., inicio">
        <img src="/images/cvg-logo.webp" alt="CVG &amp; Co." width="399" height="245" />
      </a>
      <nav class="desktop-nav" aria-label="Navegación principal">
        <a href="#servicios">Servicios</a>
        <a href="#metodo">Método</a>
        <a href="#preguntas">Preguntas</a>
      </nav>
      <a class="button button-dark button-small header-cta" href={contactHref} target="_blank" rel="noreferrer">
        Solicita un diagnóstico <span aria-hidden="true">↗</span>
      </a>
    </header>

    <main id="contenido">
      <section class="hero section-shell" id="inicio" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow reveal">ESTRATEGIA · CONTENIDO · CAMPAÑAS</p>
          <h1 id="hero-title" class="reveal">Haz que tu marketing impulse <span>el crecimiento de tu negocio.</span></h1>
          <p class="hero-description reveal">
            Estrategia, contenido, páginas web y campañas digitales para marcas que necesitan claridad y un rumbo definido.
          </p>
          <div class="hero-actions reveal">
            <a class="button button-dark" href={contactHref} target="_blank" rel="noreferrer">
              Solicita un diagnóstico <span aria-hidden="true">↗</span>
            </a>
            <span class="risk-note">Primera conversación sin costo ni compromiso</span>
          </div>
          <div class="hero-proof reveal">
            <span class="proof-mark" aria-hidden="true">C</span>
            <p><strong>Una estrategia conectada.</strong><br />Desde la primera idea hasta cada campaña.</p>
          </div>
        </div>

        <div class="hero-art reveal" aria-label="Sistema digital de CVG. Pulsa para iniciar o pausar el movimiento orbital." role="button" tabindex="0" aria-pressed="false">
          <div class="art-topline"><span>CVG / SISTEMA DIGITAL</span><span>01 — 04</span></div>
          <div class="art-orbit orbit-one"></div>
          <div class="art-orbit orbit-two"></div>
          <div class="art-core"><span>CRECER</span><strong>con<br />intención</strong><i>CVG</i></div>
          <div class="orbit-track" aria-hidden="true">
            <div class="orbit-node node-top"><div class="art-card"><span class="card-index">01</span><span>Estrategia</span><b></b></div></div>
            <div class="orbit-node node-right"><div class="art-card"><span class="card-index">02</span><span>Contenido</span><b></b></div></div>
            <div class="orbit-node node-bottom"><div class="art-card"><span class="card-index">03</span><span>Campañas</span><b></b></div></div>
            <div class="orbit-node node-left"><div class="art-card"><span class="card-index">04</span><span>Páginas web</span><b></b></div></div>
          </div>
          <div class="art-caption">Cuatro áreas. Una estrategia.</div>
        </div>
      </section>

      <section class="client-note section-shell reveal" aria-label="Marcas con las que hemos trabajado">
        <div class="client-note-copy">
          <span class="eyebrow">MARCAS QUE HAN TRABAJADO CON CVG</span>
          <p>Colaboraciones que nos inspiran a hacer un trabajo con intención.</p>
        </div>
        <ul class="client-logos" aria-label="Clientes de CVG">
          <li class="client-logo-tile">
            <img src="/images/all-care-products.webp" alt="All Care Products" width="800" height="411" loading="lazy" />
          </li>
          <li class="client-logo-tile">
            <img src="/images/tu-destino-tours.webp" alt="Tu Destino Tours and Travel" width="800" height="800" loading="lazy" />
          </li>
        </ul>
      </section>

      <section class="services section-shell" id="servicios" aria-labelledby="services-title">
        <div class="section-heading reveal">
          <p class="eyebrow">QUÉ HACEMOS</p>
          <h2 id="services-title">Lo esencial para crecer mejor.</h2>
          <p>Unimos las piezas que hacen que tu marketing tenga dirección y continuidad.</p>
        </div>
        <div class="service-grid">
          {services.map((service) => (
            <article class="service-card reveal">
              <span class="card-index">{service.number}</span>
              <div class="service-rule" aria-hidden="true"></div>
              <h3>{service.title}</h3>
              <p>{service.text}</p>
              <span class="service-arrow" aria-hidden="true">↗</span>
            </article>
          ))}
        </div>
      </section>

      <section class="manifesto section-shell" aria-label="Nuestra forma de trabajar">
        <p class="eyebrow reveal">MENOS RUIDO. MÁS DIRECCIÓN.</p>
        <h2 class="tagline" data-tagline>
          <span>El crecimiento real empieza cuando cada acción tiene un propósito.</span>
        </h2>
      </section>

      <section class="method section-shell" id="metodo" aria-labelledby="method-title">
        <div class="method-intro reveal">
          <p class="eyebrow">UN PROCESO CLARO</p>
          <h2 id="method-title">De la idea a la acción.</h2>
          <p>Un proceso directo para que sepas qué sigue y por qué.</p>
        </div>
        <div class="steps-list">
          {steps.map((step) => (
            <article class="step-row reveal">
              <span class="step-number">{step.number}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
              <span class="step-symbol" aria-hidden="true">↗</span>
            </article>
          ))}
        </div>
      </section>

      <section class="principles section-shell reveal" aria-labelledby="principles-title">
        <div>
          <p class="eyebrow">LO QUE PUEDES ESPERAR</p>
          <h2 id="principles-title">Un equipo cerca de tus objetivos.</h2>
        </div>
        <ul>
          <li><span>01</span> Prioridades claras antes de ejecutar</li>
          <li><span>02</span> Comunicación directa y continua</li>
          <li><span>03</span> Decisiones guiadas por objetivos</li>
        </ul>
      </section>

      <section class="faq section-shell" id="preguntas" aria-labelledby="faq-title">
        <div class="faq-intro reveal">
          <p class="eyebrow">PREGUNTAS FRECUENTES</p>
          <h2 id="faq-title">Lo que necesitas saber.</h2>
          <p>Si tienes otra pregunta, conversemos sobre tu caso.</p>
          <a class="text-link" href={contactHref} target="_blank" rel="noreferrer">Habla con CVG <span aria-hidden="true">↗</span></a>
        </div>
        <div class="faq-list">
          {faqs.map((faq) => (
            <details class="faq-item reveal">
              <summary>{faq.question}<span aria-hidden="true"></span></summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="final-cta section-shell reveal" id="contacto" aria-labelledby="contact-title">
        <p class="eyebrow">EL SIGUIENTE PASO EMPIEZA AQUÍ</p>
        <h2 id="contact-title">Démosle dirección<br />a tu crecimiento.</h2>
        <p>Cuéntanos qué quieres lograr y exploremos el mejor camino para tu marca.</p>
        <a class="button button-light" href={contactHref} target="_blank" rel="noreferrer">
          Solicita un diagnóstico <span aria-hidden="true">↗</span>
        </a>
        <span class="risk-note">Primera conversación sin costo ni compromiso</span>
      </section>
    </main>

    <footer class="site-footer section-shell">
      <a class="wordmark" href="#inicio" aria-label="CVG and Co., volver al inicio">
        <img src="/images/cvg-logo.webp" alt="CVG &amp; Co." width="399" height="245" loading="lazy" />
      </a>
      <p>Estrategia para crecer con intención.</p>
      <span>© {new Date().getFullYear()} CVG</span>
    </footer>
  </body>
</html>

<script>
  document.documentElement.classList.add('js');

  const revealObserver = new IntersectionObserver(
    (entries, observer) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      });
    },
    { threshold: 0.14, rootMargin: '0px 0px -32px 0px' },
  );

  document.querySelectorAll('.reveal').forEach((element) => revealObserver.observe(element));

  const solarSystem = document.querySelector('.hero-art');
  if (solarSystem) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const resumeOrbit = () => {
      if (reduceMotion.matches) return;
      solarSystem.classList.add('is-orbiting');
      solarSystem.classList.remove('is-paused');
      solarSystem.setAttribute('aria-pressed', 'true');
    };
    const pauseOrbit = () => {
      if (!solarSystem.classList.contains('is-orbiting')) return;
      solarSystem.classList.add('is-paused');
      solarSystem.setAttribute('aria-pressed', 'false');
    };
    const toggleOrbit = () => {
      if (solarSystem.classList.contains('is-orbiting') && !solarSystem.classList.contains('is-paused')) {
        pauseOrbit();
      } else {
        resumeOrbit();
      }
    };

    solarSystem.addEventListener('pointerenter', (event) => {
      if (event.pointerType === 'mouse') resumeOrbit();
    });
    solarSystem.addEventListener('pointerleave', (event) => {
      if (event.pointerType === 'mouse') pauseOrbit();
    });
    solarSystem.addEventListener('click', (event) => {
      if (event.pointerType === 'touch') toggleOrbit();
    });
    solarSystem.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      event.preventDefault();
      toggleOrbit();
    });
  }

  const tagline = document.querySelector('[data-tagline] span');
  if (tagline) {
    const words = tagline.textContent.trim().split(/\s+/);
    tagline.replaceChildren(
      ...words.map((word, index) => {
        const span = document.createElement('span');
        span.className = 'tagline-word';
        span.style.setProperty('--word-index', String(index));
        span.textContent = `${word} `;
        return span;
      }),
    );

    const wordObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('word-visible');
          observer.unobserve(entry.target);
        });
      },
      { threshold: 1, rootMargin: '0px 0px -28% 0px' },
    );

    tagline.querySelectorAll('.tagline-word').forEach((word) => wordObserver.observe(word));
  }
</script>

<style>
  :root {
    color-scheme: light;
    --paper: #f5f5f3;
    --white: #ffffff;
    --ink: #111111;
    --charcoal: #222222;
    --mid: #777777;
    --soft: #a5a5a2;
    --line: #dededb;
    --ease-fluid: cubic-bezier(0.32, 0.72, 0, 1);
  }

  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; background: var(--paper); }
  :global(body) {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: 'Manrope', sans-serif;
    font-size: 16px;
    line-height: 24px;
    -webkit-font-smoothing: antialiased;
  }
  :global(body), :global(button), :global(a) { font-family: 'Manrope', sans-serif; }
  :global(a) { color: inherit; }
  :global(::selection) { background: #222222; color: #ffffff; }
  .skip-link {
    position: fixed;
    z-index: 10;
    top: 8px;
    left: 8px;
    padding: 8px 12px;
    transform: translateY(-150%);
    background: var(--ink);
    color: var(--white);
  }
  .skip-link:focus { transform: translateY(0); }
  .section-shell { width: min(100% - 48px, 1200px); margin-inline: auto; }

  .site-header {
    position: relative;
    z-index: 5;
    display: flex;
    width: min(100% - 48px, 1200px);
    min-height: 96px;
    align-items: center;
    justify-content: space-between;
    margin: 0 auto;
  }
  .wordmark {
    color: var(--ink);
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -1.5px;
    text-decoration: none;
  }
  .wordmark img { display: block; width: 112px; height: 69px; object-fit: contain; }
  .desktop-nav { display: flex; align-items: center; gap: 32px; }
  .desktop-nav a, .site-footer a { color: #5d5d5b; font-size: 14px; text-decoration: none; }
  .desktop-nav a { transition: color 700ms var(--ease-fluid); }
  .desktop-nav a:hover { color: var(--ink); }
  .button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 8px 12px;
    border: 1px solid transparent;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 600;
    line-height: 24px;
    text-decoration: none;
    transition: transform 700ms var(--ease-fluid), background-color 700ms var(--ease-fluid), color 700ms var(--ease-fluid);
  }
  .button span { font-size: 18px; }
  .button:hover { transform: translateY(-2px); }
  .button:active { transform: translateY(1px) scale(0.98); }
  .button:focus-visible, a:focus-visible, summary:focus-visible { outline: 2px solid #555555; outline-offset: 4px; }
  .button-dark { background: var(--ink); color: var(--white); }
  .button-dark:hover { background: #363636; }
  .button-light { background: var(--white); color: var(--ink); }
  .button-light:hover { background: #e8e8e6; }
  .button-small { min-height: 40px; font-size: 14px; line-height: 20px; }

  .hero {
    display: grid;
    min-height: 584px;
    grid-template-columns: minmax(0, 1fr) minmax(400px, 0.9fr);
    align-items: center;
    gap: 64px;
    padding-block: 64px 80px;
  }
  .hero-copy { position: relative; z-index: 1; max-width: 592px; }
  .eyebrow {
    margin: 0;
    color: #656563;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.4px;
    line-height: 16px;
  }
  h1, h2, h3, p { margin-top: 0; }
  h1 {
    max-width: 680px;
    margin-block: 24px;
    background: linear-gradient(90deg, #000000 0%, #666666 100%);
    background-clip: text;
    color: transparent;
    font-size: 60px;
    font-weight: 600;
    letter-spacing: -3.8px;
    line-height: 1;
    text-wrap: balance;
  }
  h1 span { display: block; }
  .hero-description { max-width: 560px; margin-bottom: 32px; color: #5d5d5b; font-size: 18px; line-height: 28px; text-wrap: pretty; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; }
  .risk-note { color: #6e6e6c; font-size: 12px; line-height: 16px; }
  .hero-proof { display: flex; align-items: center; gap: 12px; margin-top: 48px; }
  .proof-mark {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border: 1px solid #c8c8c5;
    border-radius: 50%;
    color: #454545;
    font-size: 14px;
    font-weight: 700;
  }
  .hero-proof p { margin: 0; color: #6e6e6c; font-size: 12px; line-height: 16px; }
  .hero-proof strong { color: #222222; font-weight: 600; }

  .hero-art {
    position: relative;
    display: grid;
    min-height: 440px;
    overflow: hidden;
    place-items: center;
    border: 1px solid #d8d8d5;
    border-radius: 24px;
    background: #e9e9e6;
    cursor: pointer;
    outline: none;
  }
  .hero-art:focus-visible { outline: 2px solid #555555; outline-offset: 4px; }
  .art-topline {
    position: absolute;
    z-index: 1;
    top: 24px;
    right: 24px;
    left: 24px;
    display: flex;
    justify-content: space-between;
    color: #777774;
    font-size: 12px;
    letter-spacing: 1px;
  }
  .art-orbit { position: absolute; width: 320px; height: 320px; border: 1px solid #c8c8c4; border-radius: 50%; }
  .orbit-two { width: 240px; height: 240px; border-color: #b7b7b3; }
  .orbit-track {
    position: absolute;
    z-index: 2;
    top: 50%;
    left: 50%;
    width: 82%;
    height: 72%;
    transform: translate(-50%, -50%);
  }
  .orbit-node { position: absolute; width: 144px; height: 40px; }
  .node-top { top: 0; left: 50%; transform: translate(-50%, -50%); }
  .node-right { top: 50%; left: 100%; transform: translate(-50%, -50%); }
  .node-bottom { top: 100%; left: 50%; transform: translate(-50%, -50%); }
  .node-left { top: 50%; left: 0; transform: translate(-50%, -50%); }
  .art-core {
    position: relative;
    z-index: 1;
    display: flex;
    width: 152px;
    height: 152px;
    flex-direction: column;
    justify-content: center;
    padding: 16px;
    border-radius: 50%;
    background: #181818;
    color: #ffffff;
    text-align: center;
  }
  .art-core span { color: #bdbdb9; font-size: 10px; letter-spacing: 1.3px; }
  .art-core strong { font-size: 20px; font-weight: 500; line-height: 24px; }
  .art-core i { margin-top: 4px; color: #8d8d89; font-size: 10px; font-style: normal; letter-spacing: 1px; }
  .art-card {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    gap: 8px;
    padding: 12px;
    border: 1px solid #d2d2ce;
    border-radius: 12px;
    background: #f8f8f6;
    box-shadow: 0 16px 32px rgb(0 0 0 / 7%);
    color: #373735;
    font-size: 12px;
    font-weight: 600;
  }
  .card-index { color: #898986; font-size: 10px; font-weight: 500; }
  .art-card b { width: 6px; height: 6px; margin-left: auto; border-radius: 50%; background: #575755; }
  .art-caption { position: absolute; right: 24px; bottom: 24px; color: #737370; font-size: 12px; }
  .hero-art.is-orbiting .orbit-track { animation: orbit-spin 24s linear infinite; }
  .hero-art.is-orbiting .art-card { animation: orbit-counterspin 24s linear infinite; }
  .hero-art.is-paused .orbit-track,
  .hero-art.is-paused .art-card { animation-play-state: paused; }
  @keyframes orbit-spin { to { transform: translate(-50%, -50%) rotate(360deg); } }
  @keyframes orbit-counterspin { to { transform: rotate(-360deg); } }

  .client-note {
    display: flex;
    min-height: 160px;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .client-note-copy { max-width: 440px; }
  .client-note-copy .eyebrow { display: block; margin-bottom: 8px; }
  .client-note-copy p { margin: 0; color: #555553; font-size: 18px; line-height: 28px; }
  .client-logos { display: flex; align-items: center; gap: 16px; margin: 0; padding: 0; list-style: none; }
  .client-logo-tile { display: grid; width: 200px; height: 112px; place-items: center; padding: 16px; border: 1px solid #dededb; border-radius: 12px; background: #ffffff; }
  .client-logo-tile img { display: block; max-width: 100%; max-height: 80px; object-fit: contain; }

  .services { padding-block: 96px; }
  .section-heading { display: grid; max-width: 720px; grid-template-columns: 1fr; gap: 12px; margin-bottom: 40px; }
  .section-heading h2, .method-intro h2, .faq-intro h2, .principles h2 {
    margin: 0;
    font-size: 48px;
    font-weight: 600;
    letter-spacing: -2.2px;
    line-height: 1;
    text-wrap: balance;
  }
  .section-heading > p:last-child, .method-intro > p:last-child, .faq-intro > p:not(.eyebrow) {
    max-width: 560px;
    margin: 0;
